{
  "name": "@rayrabbit-ai/ai-engineering",
  "version": "1.0.0",
  "description": "Deterministic AI Engineering Template: Polyglot (TypeScript + Python) SDD + Strict TDD + CI Gates",
  "type": "module",
  "keywords": [
    "ai-engineering",
    "typescript",
    "python",
    "tdd",
    "sdd",
    "openspec",
    "vitest",
    "pytest",
    "antigravity",
    "cursor",
    "claude-code"
  ],
  "author": "RayRabbit AI <dev@rayrabbit.site> (https://github.com/rayrabbit-ai)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rayrabbit-ai/ai-engineering.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "spec:list": "openspec list",
    "spec:validate": "openspec validate --all",
    "spec:view": "openspec view",
    "test:ts": "vitest run",
    "test:ts:unit": "vitest run tests/ts/unit",
    "test:ts:integration": "vitest run tests/ts/integration",
    "test:ts:baseline": "vitest run tests/ts/characterization",
    "test:ts:e2e": "vitest run tests/ts/e2e",
    "test:ts:coverage": "vitest run --coverage",
    "test:py": "pytest",
    "test:py:coverage": "pytest -m \"unit or integration\" --cov=src --cov-branch --cov-report=term-missing --cov-report=json:.coverage-python.json && python scripts/check_python_coverage.py .coverage-python.json --min-lines 80 --min-branches 75",
    "verify:gates": "node scripts/verify-gates.mjs",
    "verify:gates:self-test": "node scripts/verify-gates.mjs --self-test",
    "verify:gates:py": "python scripts/verify_gates.py",
    "verify:gates:py:self-test": "python scripts/verify_gates.py --self-test",
    "verify:red": "node scripts/verify-red-failure.mjs",
    "verify:red:self-test": "node scripts/verify-red-failure.mjs --self-test",
    "verify:red:py": "python scripts/verify_red_failure.py",
    "verify:red:py:self-test": "python scripts/verify_red_failure.py --self-test",
    "check:coverage:py": "python scripts/check_python_coverage.py",
    "audit:redteam": "node scripts/redteam-audit.mjs --report docs/audit/informe-redteam.es.md",
    "guard": "node scripts/guard-agent.mjs",
    "prepare": "node scripts/guard-agent.mjs",
    "setup:branch-protection": "python scripts/setup_branch_protection.py"
  },
  "devDependencies": {
    "@fission-ai/openspec": "0.17.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "^5.3.3",
    "vitest": "5.0.4"
  }
}
